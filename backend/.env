# Backend Environment Variables for SQLite
SECRET_KEY=dev-secret-key-change-in-production
FLASK_ENV=development

# SMS Configuration (Philippine SMS Gateway - ridvanbaluyos/sms)
# Default: Semaphore (https://semaphore.co)
# Set SMS_API_KEY=mock for local testing / capstone demo without SMS credits
SMS_API_KEY=mock
SMS_API_URL=https://api.semaphore.co/api/v4/messages
SMS_SENDER_NAME=BrgyHomapon

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
