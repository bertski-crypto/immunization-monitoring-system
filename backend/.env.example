# Backend Environment Variables
# SQLite is used - no MySQL server required

# Optional: override the SQLite database path (absolute path)
# DATABASE_URL=sqlite:////absolute/path/to/immunization.db
# Leave unset to use the default: backend/immunization.db

SECRET_KEY=your-secret-key-change-in-production
FLASK_ENV=development

# SMS Configuration (Philippine SMS Providers - ridvanbaluyos/sms)
# Providers supported: Semaphore (https://semaphore.co), PromoTexter (promotexter.com)
# Set to 'mock' for local development & demonstration without SMS credits
SMS_API_KEY=mock
SMS_API_URL=https://api.semaphore.co/api/v4/messages
SMS_SENDER_NAME=BrgyHomapon

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
